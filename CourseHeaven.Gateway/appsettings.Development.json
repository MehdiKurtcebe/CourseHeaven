{
  "ReverseProxy": {
    "Routes": {
      "basket-route": {
        "ClusterId": "basket.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/baskets/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/baskets/{**catch-all}"
          }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/catalogs/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/{**catch-all}"
          }
        ]
      },
      "discount-route": {
        "ClusterId": "discount.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/discounts/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/discounts/{**catch-all}"
          }
        ]
      },
      "file-route": {
        "ClusterId": "file.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/files"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/files"
          }
        ]
      },
      "order-route": {
        "ClusterId": "order.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/orders/{**catch-all}"
          }
        ]
      },
      "payment-route": {
        "ClusterId": "payment.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/payments/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "basket.cluster": {
        "Destinations": {
          "basket.destination": {
            "Address": "http://localhost:5159/"
          }
        }
      },
      "catalog.cluster": {
        "Destinations": {
          "catalog.destination": {
            "Address": "http://localhost:5107/"
          }
        }
      },
      "discount.cluster": {
        "Destinations": {
          "discount.destination": {
            "Address": "http://localhost:5299/"
          }
        }
      },
      "file.cluster": {
        "Destinations": {
          "file.destination": {
            "Address": "http://localhost:5008/"
          }
        }
      },
      "order.cluster": {
        "Destinations": {
          "order.destination": {
            "Address": "http://localhost:5271/"
          }
        }
      },
      "payment.cluster": {
        "Destinations": {
          "payment.destination": {
            "Address": "http://localhost:5087/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
