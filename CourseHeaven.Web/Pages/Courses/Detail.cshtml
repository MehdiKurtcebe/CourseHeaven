@page
@model DetailModel
@{
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <course-thumbnail-picture class="card-img-top img-fluid" alt="Course Image"
                                src="@Model.Course!.ImageUrl"></course-thumbnail-picture>
                <div class="card-body">
                    <h2 class="mb-4">@Model.Course.Name</h2>
                    <h5 class="card-title">Course Description</h5>
                    <p>@Model.Course.Description</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <h5 class="card-title">Category</h5>
                    <p class="card-text">@Model.Course.CategoryName</p>
                    <hr>
                    <h5 class="card-title">Price</h5>
                    <p class="card-text">
                        <strong>@Model.Course.Price.ToString("C")</strong>
                    </p>
                    <hr>
                    <h5 class="card-title">Details</h5>
                    <p class="card-text">
                        <small class="text-muted">Instructor: <strong>@Model.Course.EducatorFullName</strong></small>
                    </p>
                    <p class="card-text">
                        <small class="text-muted">Creation Date: <strong>@Model.Course.CreatedAt</strong></small>
                    </p>
                    <p class="card-text">
                        <small class="text-muted">Rating: <strong>@Model.Course.Rating</strong> | Duration:
                            <strong>@Model.Course.Duration</strong> hours</small>
                    </p>
                </div>
                <div class="card-footer bg-light text-center">
                    <a asp-page="/basket/index" asp-page-handler="AddBasket" asp-route-courseId="@Model.Course.Id"
                       class="btn btn-primary">Add To Basket</a>
                </div>
            </div>
        </div>
    </div>
</div>